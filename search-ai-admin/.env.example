# Local Vite proxy prefix. It forwards to the standalone Search AI service (port 8002).
VITE_SEARCH_API_BASE_URL=/search-api

# Server-only Vite proxy target. Do not prefix this with VITE_ or put secrets here.
SEARCH_AI_TARGET=http://127.0.0.1:8002

# For a future hosted deployment, set VITE_SEARCH_API_BASE_URL to the public prefix
# (for example /search-ai) only after the BONC reverse proxy has been configured to
# forward that prefix to Search AI and strip the prefix before forwarding.
VITE_BASE_PATH=./

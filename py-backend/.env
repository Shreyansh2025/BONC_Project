# APP_ENV controls which SQL Server connection is used — set to exactly one of:
#   local       -> uses SQL_SERVER_ODBC_CONNECT_LOCAL       (your own machine)
#   staging     -> uses SQL_SERVER_ODBC_CONNECT_STAGING     (the staging/test server)
#   production  -> uses SQL_SERVER_ODBC_CONNECT_PRODUCTION  (the live boncnetwork.com database)

APP_ENV=local

SQL_SERVER_ODBC_CONNECT_LOCAL=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=BrochureApp;Trusted_Connection=yes;TrustServerCertificate=yes;

SQL_SERVER_ODBC_CONNECT_STAGING=Server=94.136.187.41,1433;Initial Catalog=RN_BoncNetwork_Staging;Persist Security Info=False;User ID=sa;Password=Miha@IRLG#1981;MultipleActiveResultSets=False;Encrypt=False;TrustServerCertificate=True;Connection Timeout=30;

SQL_SERVER_ODBC_CONNECT_PRODUCTION=DRIVER={ODBC Driver 18 for SQL Server};SERVER=94.136.187.41,1433;DATABASE=RN_BoncNetwork_Prod;UID=Intern_ReadOnly;PWD=StrongPassword@123;Encrypt=yes;TrustServerCertificate=yes;Connection Timeout=30;

